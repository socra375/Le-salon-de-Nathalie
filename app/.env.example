# Copia este archivo a .env (nunca lo subas a git) y completa con los
# valores de tu proyecto: Supabase > Project Settings > API.
#
# La anon key es pública por diseño (protegida por RLS) — no es un secreto
# que haya que ocultar, pero igual no debe versionarse por archivo .env,
# para poder cambiarla sin tocar código si algún día hace falta rotarla.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
